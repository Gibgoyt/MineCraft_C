# Render distance changed in a world that stays open, in the built program, at 640 by 480, scale 2. The settings file it starts from says 8 and
# 8. Worked out by hand from the layouts in run/src/ui/menu/index.c and run/src/ui/screen_settings/index.c. The pointer starts at 320, 240 once
# tick 0 has shown it the canvas, and it moves only on screens.

1 move 0 -40                    # 320, 200: Singleplayer
+1 button left down
+1 button left up
+1 move 132 196                 # 452, 396: Create New World
+1 button left down
+1 button left up
+1 key l down
+1 key l up
+1 key i down
+1 key i up
+1 key v down
+1 key v up
+1 key e down
+1 key e up
+1 move -132 -194               # 320, 202: the seed field
+1 button left down
+1 button left up
+1 key 1 down
+1 key 1 up
+1 key 2 down
+1 key 2 up
+1 key 3 down
+1 key 3 up
+1 key enter down               # opens the world, between this tick and the next
+1 key enter up

+3 move 1250 -160               # turns round to the far side of the valley, and looks at the horizon: the pointer stays where it was
+4 screenshot at_8.png

# Esc, Settings, 8 down to 2 by the wheel, and looks behind the screen.
+1 key escape down
+1 key escape up
+1 move 0 46                    # 320, 248: Settings, on the pause screen
+1 button left down
+1 button left up
+1 screenshot screen.png
+1 move 0 -180                  # 320, 68: the first slider
+1 wheel -6
+17 screenshot behind_2.png     # what the change waits for is over
+1 move 0 384                   # 320, 452: Done
+1 button left down
+1 button left up
+1 screenshot pause_after_2.png
+1 key escape down
+1 key escape up
+3 screenshot at_2.png

# The same to 8 again: what was there comes back.
+1 key escape down
+1 key escape up
+1 move 0 -204                  # 320, 248
+1 button left down
+1 button left up
+1 move 0 -180                  # 320, 68
+1 wheel 6
+17 move 0 384                  # 320, 452
+1 button left down
+1 button left up
+1 key escape down
+1 key escape up
+3 screenshot at_8_again.png

# Down to 4: what the file ends up holding, and Done does not wait for the change.
+1 key escape down
+1 key escape up
+1 move 0 -204                  # 320, 248
+1 button left down
+1 button left up
+1 move 0 -180                  # 320, 68
+1 wheel -4
+1 move 0 384                   # 320, 452: Done
+1 button left down
+1 button left up
+1 key escape down
+1 key escape up
+3 screenshot at_4.png
+1 key escape down
+1 key escape up
+1 move 0 -156                  # 320, 296: Quit to Title
+1 button left down
+1 button left up
+1 button left down             # the same place: Quit Game
+1 button left up
+1 end
