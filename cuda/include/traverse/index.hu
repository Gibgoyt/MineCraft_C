/* See cuda/src/traverse/README.md. The C API, and the ray loop itself. The loop is here because a device function cannot be
 * called across translation units without device linking, and later areas (sun rays in shade) need the same loop. */
#ifndef MC_CUDA_TRAVERSE_INDEX_HU
#define MC_CUDA_TRAVERSE_INDEX_HU

#include "device_memory/index.hu"
#include "gpu_bridge/traverse/index.h"

#include <math.h>

/* A direction component nearer zero than this becomes this, keeping its sign, so that its inverse stays finite. A test's CPU
 * reference applies the same rule. */
#define TRAVERSE_DIRECTION_FLOOR 1e-6F

/* The world, with what a kernel needs worked out from traverse_world_t. Passed to kernels by value. */
typedef struct traverse_view_t {
    const world_buffers_column_t *borrowed_table; /* 0 */
    const uint8_t *borrowed_pool;                 /* 8 */
    const uint8_t *borrowed_shapes;               /* 16: a traverse_shape_t per material, or nullptr for all cubes */
    int32_t window_min_block[2];                  /* 24 */
    int32_t window_min_column[2];                 /* 32 */
    uint32_t origin_slot[2];                      /* 40: the table slot of the window's low corner column */
    uint32_t columns_wide;                        /* 48 */
    uint32_t window_blocks;                       /* 52 */
    uint32_t max_steps;                           /* 56: see traverse_view_from for why this is enough */
    uint16_t shape_count;                         /* 60 */
    uint16_t top_limit;                           /* 62: see traverse_world_t; TRAVERSE_HEIGHT_BLOCKS when not known */
} traverse_view_t;
static_assert(sizeof(traverse_view_t) == 64);
static_assert(alignof(traverse_view_t) == 8);

/* A ray ready to trace: eye_cell[2] is a storage height from here on, not a world z. */
typedef struct traverse_trace_ray_t {
    int32_t eye_cell[3];    /* 0 */
    float32_t eye_frac[3];  /* 12 */
    float32_t direction[3]; /* 24: unit length, with no component below TRAVERSE_DIRECTION_FLOOR */
    float32_t t_start;      /* 36 */
    /* 40: 0 for a ray starting out, where t_start is inside a block if it is inside a block. 1 for a ray going on past a surface
     * at t_start: it takes only what it enters after t_start, so what it just left, and its far side, are nothing to it. */
    uint32_t resume;
} traverse_trace_ray_t;
static_assert(sizeof(traverse_trace_ray_t) == 44);
static_assert(alignof(traverse_trace_ray_t) == 4);

/* A box inside a voxel, in units of TRAVERSE_BOX_UNIT of a block from its low corner. */
#define TRAVERSE_BOX_UNIT (1.0F / 32.0F)
typedef struct traverse_box_t {
    uint8_t low[3];  /* 0 */
    uint8_t high[3]; /* 3 */
} traverse_box_t;
static_assert(sizeof(traverse_box_t) == 6);

/* A row of the table: traverse_shape_t is its index. */
typedef struct traverse_shape_row_t {
    uint8_t first; /* 0: into traverse_boxes */
    uint8_t count; /* 1 */
} traverse_shape_row_t;
static_assert(sizeof(traverse_shape_row_t) == 2);

/* The shape table. Here and not in the .cu because the loop that reads it is here, and each file with the loop in it needs its
 * own copy on the card. A plate is one texel thick, 2 of these units, and the texture on its wide sides is the whole of the
 * block's, so a plant shows all of its picture. The boxes of a shape may meet but need not be sorted: the nearest wins. */
static __constant__ const traverse_box_t traverse_boxes[] = {
    {{0, 0, 0}, {32, 32, 32}},   /* 0: cube */
    {{0, 0, 0}, {32, 32, 16}},   /* 1: slab, and the lower half of the stairs */
    {{0, 16, 16}, {32, 32, 32}}, /* 2: the upper half of the stairs */
    {{0, 15, 0}, {32, 17, 32}},  /* 3: cross, along x */
    {{15, 0, 0}, {17, 32, 32}},  /* 4: cross, along y */
    {{0, 7, 0}, {32, 9, 32}},    /* 5: crop, along x at a quarter */
    {{0, 23, 0}, {32, 25, 32}},  /* 6: crop, along x at three quarters */
    {{7, 0, 0}, {9, 32, 32}},    /* 7: crop, along y at a quarter */
    {{23, 0, 0}, {25, 32, 32}},  /* 8: crop, along y at three quarters */
    {{14, 14, 0}, {18, 18, 20}}, /* 9: torch: two texels wide and ten tall, where the texture has it */
    {{0, 30, 0}, {32, 32, 32}},  /* 10: plate */
    {{0, 0, 0}, {32, 32, 2}},    /* 11: flat */
};
static __constant__ const traverse_shape_row_t traverse_shape_rows[TRAVERSE_SHAPE_COUNT] = {
    {0u, 1u},  /* TRAVERSE_SHAPE_CUBE */
    {1u, 1u},  /* TRAVERSE_SHAPE_SLAB */
    {1u, 2u},  /* TRAVERSE_SHAPE_STAIRS */
    {3u, 2u},  /* TRAVERSE_SHAPE_CROSS */
    {5u, 4u},  /* TRAVERSE_SHAPE_CROP */
    {9u, 1u},  /* TRAVERSE_SHAPE_TORCH */
    {10u, 1u}, /* TRAVERSE_SHAPE_PLATE */
    {11u, 1u}, /* TRAVERSE_SHAPE_FLAT */
};

/* A pixel's unit direction: see traverse_camera_t. Shade and post need the same ray as traversal did. */
static __device__ __forceinline__ void traverse_camera_direction(const traverse_camera_t *camera, float32_t pixel_x,
                                                                 float32_t pixel_y, float32_t out[3]) {
    const float32_t u = 2.0F * pixel_x / (float32_t)camera->width - 1.0F;
    const float32_t v = 1.0F - 2.0F * pixel_y / (float32_t)camera->height;
    const float32_t x = camera->forward[0] + u * camera->right[0] + v * camera->up[0];
    const float32_t y = camera->forward[1] + u * camera->right[1] + v * camera->up[1];
    const float32_t z = camera->forward[2] + u * camera->right[2] + v * camera->up[2];
    const float32_t scale = 1.0F / sqrtf(x * x + y * y + z * z);
    out[0] = x * scale;
    out[1] = y * scale;
    out[2] = z * scale;
}

static __device__ __forceinline__ int32_t traverse_clamp(int32_t value, int32_t low, int32_t high) {
    return value < low ? low : (value > high ? high : value);
}

static __device__ __forceinline__ float32_t traverse_guard(float32_t value) {
    if (value > -TRAVERSE_DIRECTION_FLOOR && value < TRAVERSE_DIRECTION_FLOOR) {
        return value < 0.0F ? -TRAVERSE_DIRECTION_FLOOR : TRAVERSE_DIRECTION_FLOOR;
    }
    return value;
}

/* The table slot of a column in the window. No modulo in the loop: the origin slot is worked out once. */
static __device__ __forceinline__ uint32_t traverse_slot(const traverse_view_t *view, int32_t column_x,
                                                         int32_t column_y) {
    uint32_t slot_x = (uint32_t)(column_x - view->window_min_column[0]) + view->origin_slot[0];
    uint32_t slot_y = (uint32_t)(column_y - view->window_min_column[1]) + view->origin_slot[1];
    slot_x = slot_x >= view->columns_wide ? slot_x - view->columns_wide : slot_x;
    slot_y = slot_y >= view->columns_wide ? slot_y - view->columns_wide : slot_y;
    return slot_y * view->columns_wide + slot_x;
}

/* One above a column's highest block, as a storage height, or 0 when there is nothing in it: when the slot is empty, or still
 * holds the column that wrapped out of this place. So every height is above it, and the masks are never read. */
static __device__ __forceinline__ int32_t traverse_column_top(const world_buffers_column_t *column, int32_t column_x,
                                                              int32_t column_y) {
    if (column->ready == 0u || column->chunk_x != column_x || column->chunk_y != column_y) {
        return 0;
    }
    return (int32_t)column->top_z - TRAVERSE_Z_BASE + 1;
}

/* A section's bytes in the pool, from a place in the table. */
static __device__ __forceinline__ const uint8_t *traverse_section_bytes(const traverse_view_t *view, uint32_t entry) {
    return view->borrowed_pool + (uint64_t)(entry - 1u) * WORLD_BUFFERS_GRANULE_BYTES;
}

/* The value of a voxel known to be there, at this place among the section's voxels: place 0 in a uniform section. */
static __device__ __forceinline__ uint32_t traverse_section_value(const uint8_t *encoded,
                                                                  const world_buffers_section_t *header,
                                                                  uint32_t place) {
    const uint32_t material = ((const uint16_t *)(const void *)(encoded + header->material_offset))[place];
    const uint32_t light = (encoded + header->light_offset)[place];
    return material | light << TRAVERSE_VALUE_LIGHT_SHIFT;
}

/* Fills a hit for the voxel the loop stopped in. The face is worked out from the voxel and not from the last step: the last
 * step may have left a large empty node, and it says nothing exact about the voxel (Stage 01.3 issues 3 and 4). A ray enters a
 * box at the latest of its three near planes. */
static __device__ __forceinline__ void traverse_hit_found(const traverse_trace_ray_t *ray, const float32_t inverse[3],
                                                          const int32_t cell[3], uint32_t value, uint32_t steps,
                                                          traverse_hit_t *hit) {
    float32_t t = -1e30F;
    uint32_t axis = 0u;
    int32_t offset[3];
    for (uint32_t i = 0u; i < 3u; i += 1u) {
        offset[i] = cell[i] - ray->eye_cell[i];
        const float32_t near_plane = (float32_t)(ray->direction[i] > 0.0F ? offset[i] : offset[i] + 1);
        const float32_t t_near = (near_plane - ray->eye_frac[i]) * inverse[i];
        if (t_near > t) {
            t = t_near;
            axis = i;
        }
    }
    uint32_t face = axis * 2u + (ray->direction[axis] > 0.0F ? 0u : 1u);
    if (t <= ray->t_start) {
        t = ray->t_start;
        face = TRAVERSE_FACE_INSIDE;
    }
    hit->t = t;
    hit->value = value;
    hit->offset[0] = (int16_t)offset[0];
    hit->offset[1] = (int16_t)offset[1];
    hit->offset[2] = (int16_t)offset[2];
    const uint32_t reported = steps > TRAVERSE_INFO_STEPS_MAX ? TRAVERSE_INFO_STEPS_MAX : steps;
    hit->info = (uint16_t)(face | reported << TRAVERSE_INFO_STEPS_SHIFT);
}

/* The hit for a voxel with a block in it, if the ray meets what that block draws as. False means the ray goes through this voxel.
 * A cube on a ray starting out meets the ray by the loop's having got here, and takes the short way. Otherwise each box is cut
 * against the ray from the eye, whole number first, so that for a cube this t is the same bits as traverse_hit_found's: a ray
 * going on from a hole relies on that, to see it is past what it left. */
static __device__ __forceinline__ bool traverse_voxel_hit(const traverse_view_t *view, const traverse_trace_ray_t *ray,
                                                          const float32_t inverse[3], const int32_t cell[3],
                                                          uint32_t value, uint32_t steps, traverse_hit_t *hit) {
    uint32_t shape = TRAVERSE_SHAPE_CUBE;
    const uint32_t material = value & TRAVERSE_VALUE_MATERIAL_MASK;
    if (view->borrowed_shapes != nullptr && material < view->shape_count) {
        const uint32_t given = view->borrowed_shapes[material];
        shape = given < TRAVERSE_SHAPE_COUNT ? given : (uint32_t)TRAVERSE_SHAPE_CUBE;
    }
    if (shape == TRAVERSE_SHAPE_CUBE && ray->resume == 0u) {
        traverse_hit_found(ray, inverse, cell, value, steps, hit);
        return true;
    }
    int32_t offset[3];
    for (uint32_t i = 0u; i < 3u; i += 1u) {
        offset[i] = cell[i] - ray->eye_cell[i];
    }
    const traverse_shape_row_t row = traverse_shape_rows[shape];
    float32_t best = 1e30F;
    uint32_t best_face = 0u;
    bool found = false;
    for (uint32_t b = 0u; b < row.count; b += 1u) {
        const traverse_box_t box = traverse_boxes[row.first + b];
        float32_t t_in = -1e30F, t_out = 1e30F;
        uint32_t axis = 0u;
        for (uint32_t i = 0u; i < 3u; i += 1u) {
            const uint32_t near_units = ray->direction[i] > 0.0F ? box.low[i] : box.high[i];
            const uint32_t far_units = ray->direction[i] > 0.0F ? box.high[i] : box.low[i];
            const float32_t near_plane = (float32_t)offset[i] + (float32_t)near_units * TRAVERSE_BOX_UNIT;
            const float32_t far_plane = (float32_t)offset[i] + (float32_t)far_units * TRAVERSE_BOX_UNIT;
            const float32_t t_near = (near_plane - ray->eye_frac[i]) * inverse[i];
            const float32_t t_far = (far_plane - ray->eye_frac[i]) * inverse[i];
            if (t_near > t_in) {
                t_in = t_near;
                axis = i;
            }
            t_out = t_far < t_out ? t_far : t_out;
        }
        if (!(t_in < t_out)) {
            continue;
        }
        float32_t t = t_in;
        uint32_t face = axis * 2u + (ray->direction[axis] > 0.0F ? 0u : 1u);
        if (ray->resume != 0u) {
            if (!(t_in > ray->t_start)) {
                continue;
            }
        } else {
            if (t_out <= ray->t_start) {
                continue;
            }
            if (t_in <= ray->t_start) {
                /* An eye among a plant's plates sees on past them, and does not go dark as inside a block with a body. */
                if (shape >= TRAVERSE_SHAPE_CROSS) {
                    continue;
                }
                t = ray->t_start;
                face = TRAVERSE_FACE_INSIDE;
            }
        }
        if (t < best) {
            best = t;
            best_face = face;
            found = true;
        }
    }
    if (!found) {
        return false;
    }
    hit->t = best;
    hit->value = value;
    hit->offset[0] = (int16_t)offset[0];
    hit->offset[1] = (int16_t)offset[1];
    hit->offset[2] = (int16_t)offset[2];
    const uint32_t reported = steps > TRAVERSE_INFO_STEPS_MAX ? TRAVERSE_INFO_STEPS_MAX : steps;
    hit->info = (uint16_t)(best_face | reported << TRAVERSE_INFO_STEPS_SHIFT);
    return true;
}

static __device__ __forceinline__ void traverse_hit_missed(uint32_t steps, bool capped, traverse_hit_t *hit) {
    const uint32_t reported = steps > TRAVERSE_INFO_STEPS_MAX ? TRAVERSE_INFO_STEPS_MAX : steps;
    hit->t = TRAVERSE_COARSE_SKY;
    hit->value = 0u;
    hit->offset[0] = 0;
    hit->offset[1] = 0;
    hit->offset[2] = 0;
    hit->info = (uint16_t)((uint32_t)TRAVERSE_FACE_MISS | reported << TRAVERSE_INFO_STEPS_SHIFT |
                           (capped ? TRAVERSE_INFO_CAPPED : 0u));
}

/* One ray through the tree: Amanatides and Woo, stepping through the largest empty node holding the current cell, and reading
 * masks again only when the cell has left the column, section or brick it has cached. Stage 01.3 issues 2, 3 and 4 are why it
 * is the way it is, and each is marked. */
static __device__ __forceinline__ void traverse_trace(const traverse_view_t *view, const traverse_trace_ray_t *ray,
                                                      traverse_hit_t *hit) {
    const float32_t dx = ray->direction[0], dy = ray->direction[1], dz = ray->direction[2];
    const float32_t fx = ray->eye_frac[0], fy = ray->eye_frac[1], fz = ray->eye_frac[2];
    const int32_t ex = ray->eye_cell[0], ey = ray->eye_cell[1], ez = ray->eye_cell[2];
    const float32_t inverse[3] = {1.0F / dx, 1.0F / dy, 1.0F / dz};
    const float32_t ix = inverse[0], iy = inverse[1], iz = inverse[2];
    const int32_t window_x = view->window_min_block[0], window_y = view->window_min_block[1];
    const uint32_t width = view->window_blocks;
    const int32_t height = (int32_t)TRAVERSE_HEIGHT_BLOCKS;
    /* A rising ray at this height has only sky left. A falling one needs no number here: it leaves by the floor. */
    const int32_t gone_at = dz > 0.0F ? (int32_t)view->top_limit : height;

    /* Clip to the window, from the eye: its planes are whole numbers relative to the eye cell, so nothing is lost. */
    const float32_t ax = ((float32_t)(window_x - ex) - fx) * ix,
                    bx = ((float32_t)(window_x + (int32_t)width - ex) - fx) * ix;
    const float32_t ay = ((float32_t)(window_y - ey) - fy) * iy,
                    by = ((float32_t)(window_y + (int32_t)width - ey) - fy) * iy;
    const float32_t az = ((float32_t)(0 - ez) - fz) * iz, bz = ((float32_t)(height - ez) - fz) * iz;
    const float32_t t_near = fmaxf(fmaxf(fminf(ax, bx), fminf(ay, by)), fmaxf(fminf(az, bz), ray->t_start));
    const float32_t t_far = fminf(fminf(fmaxf(ax, bx), fmaxf(ay, by)), fmaxf(az, bz));
    if (!(t_near < t_far)) {
        traverse_hit_missed(0u, false, hit);
        return;
    }
    int32_t x = traverse_clamp((int32_t)floorf(fx + dx * t_near) + ex, window_x, window_x + (int32_t)width - 1);
    int32_t y = traverse_clamp((int32_t)floorf(fy + dy * t_near) + ey, window_y, window_y + (int32_t)width - 1);
    int32_t z = traverse_clamp((int32_t)floorf(fz + dz * t_near) + ez, 0, height - 1);

    uint32_t cached_slot = 0xFFFFFFFFu;
    int32_t cached_section = -1, cached_brick = -1;
    const world_buffers_column_t *column = nullptr;
    int32_t column_top = 0;
    int32_t region_top = height;
    uint64_t column_mask = 0u;
    const uint8_t *encoded = nullptr;
    world_buffers_section_t header = {};
    uint64_t brick_mask = 0u;
    uint32_t brick_rank = 0u;
    uint32_t steps = 0u;
    for (; steps < view->max_steps; steps += 1u) {
        if (((uint32_t)(x - window_x) >= width) | ((uint32_t)(y - window_y) >= width) |
            ((uint32_t)z >= (uint32_t)gone_at)) {
            traverse_hit_missed(steps, false, hit);
            return;
        }
        const uint32_t slot = traverse_slot(view, x >> 4, y >> 4);
        if (slot != cached_slot) {
            column = &view->borrowed_table[slot];
            column_top = traverse_column_top(column, x >> 4, y >> 4);
            column_mask = column->section_mask;
            /* A slot holding another column has no say about this place. */
            region_top = column_top != 0 && column->region_top != 0u ? (int32_t)column->region_top << 4 : height;
            cached_slot = slot;
            cached_section = -1;
        }
        int32_t shift = 4;
        int32_t z_low, z_high;
        if (z >= column_top) {
            /* Above everything in this column: the node goes up to the top of the world, the early exit for sky rays. Above its whole
             * square as well, the node is the whole square, for a ray that goes a long way low over the ground. */
            if (z >= region_top) {
                shift = (int32_t)WORLD_BUFFERS_REGION_SHIFT + 4;
                z_low = region_top;
            } else {
                z_low = column_top;
            }
            z_high = height;
        } else {
            const int32_t section_z = z >> 4;
            if ((column_mask >> section_z) & 1u) {
                if (section_z != cached_section) {
                    encoded = traverse_section_bytes(view, column->sections[section_z]);
                    header = *(const world_buffers_section_t *)(const void *)encoded;
                    cached_section = section_z;
                    cached_brick = -1;
                }
                const int32_t brick = ((x >> 2) & 3) | (((y >> 2) & 3) << 2) | (((z >> 2) & 3) << 4);
                if (header.brick_count == 0u) {
                    const int32_t cell[3] = {x, y, z};
                    if (traverse_voxel_hit(view, ray, inverse, cell, traverse_section_value(encoded, &header, 0u),
                                           steps, hit)) {
                        return;
                    }
                    /* A section all of one shape, and this ray passed this voxel's box by: on to the next voxel. */
                    shift = 0;
                } else if ((header.brick_mask >> brick) & 1u) {
                    const uint8_t *const after_header = encoded + sizeof(world_buffers_section_t);
                    if (brick != cached_brick) {
                        const uint64_t below = header.brick_mask & ((1ull << brick) - 1ull);
                        brick_rank = (uint32_t)__popcll(below);
                        brick_mask = ((const uint64_t *)(const void *)after_header)[brick_rank];
                        cached_brick = brick;
                    }
                    const int32_t voxel = (x & 3) | ((y & 3) << 2) | ((z & 3) << 4);
                    if ((brick_mask >> voxel) & 1u) {
                        const uint8_t *const after_words = after_header + (uint32_t)header.brick_count * 8u;
                        const uint32_t first = ((const uint16_t *)(const void *)after_words)[brick_rank];
                        const uint64_t before = brick_mask & ((1ull << voxel) - 1ull);
                        const uint32_t value =
                            traverse_section_value(encoded, &header, first + (uint32_t)__popcll(before));
                        const int32_t cell[3] = {x, y, z};
                        if (traverse_voxel_hit(view, ray, inverse, cell, value, steps, hit)) {
                            return;
                        }
                    }
                    shift = 0;
                } else {
                    shift = 2;
                }
            }
            z_low = z & ~((1 << shift) - 1);
            z_high = z_low + (1 << shift);
        }
        const int32_t x_low = x & ~((1 << shift) - 1), x_high = x_low + (1 << shift);
        const int32_t y_low = y & ~((1 << shift) - 1), y_high = y_low + (1 << shift);
        /* (plane - origin) * inverse, never plane * inverse - origin * inverse. The second form lost up to tens of blocks of t
         * on near-axis rays, and gave 23 % wrong voxels on one path: Stage 01.3 issue 2. */
        const float32_t tx = ((float32_t)((dx > 0.0F ? x_high : x_low) - ex) - fx) * ix;
        const float32_t ty = ((float32_t)((dy > 0.0F ? y_high : y_low) - ey) - fy) * iy;
        const float32_t tz = ((float32_t)((dz > 0.0F ? z_high : z_low) - ez) - fz) * iz;
        /* A coordinate never moves against the ray. Clamped only to the node, a near-tie of two planes bounced a ray between
         * two cells until the cap: Stage 01.3 issue 3. So the near bound is the current cell, and a ray takes at most
         * width + width + height steps. */
        const int32_t x_min = dx > 0.0F ? x : x_low, x_max = dx > 0.0F ? x_high - 1 : x;
        const int32_t y_min = dy > 0.0F ? y : y_low, y_max = dy > 0.0F ? y_high - 1 : y;
        const int32_t z_min = dz > 0.0F ? z : z_low, z_max = dz > 0.0F ? z_high - 1 : z;
        /* Every coordinate worked out, and one kept, with no branch on which axis: rays of a warp that part here would each run their
         * own side while the others wait, on every step. See the phase 17 stage 3 file. */
        const bool step_x = tx <= ty && tx <= tz;
        const bool step_y = !step_x && ty <= tz;
        const float32_t t_step = step_x ? tx : (step_y ? ty : tz);
        const int32_t along_x = traverse_clamp((int32_t)floorf(fx + dx * t_step) + ex, x_min, x_max);
        const int32_t along_y = traverse_clamp((int32_t)floorf(fy + dy * t_step) + ey, y_min, y_max);
        const int32_t along_z = traverse_clamp((int32_t)floorf(fz + dz * t_step) + ez, z_min, z_max);
        const int32_t next_x = step_x ? (dx > 0.0F ? x_high : x_low - 1) : along_x;
        const int32_t next_y = step_y ? (dy > 0.0F ? y_high : y_low - 1) : along_y;
        const int32_t next_z = !step_x && !step_y ? (dz > 0.0F ? z_high : z_low - 1) : along_z;
        x = next_x;
        y = next_y;
        z = next_z;
    }
    traverse_hit_missed(steps, true, hit);
}

/* ---- For the host side of any area whose kernel runs that loop ------------------------------------------------------- */

static inline gpu_status_t traverse_refuse(gpu_error_t *error, const char *what) {
    *error = gpu_error_t{what, nullptr, nullptr, 0, GPU_STATUS_INVALID_ARGUMENT};
    return GPU_STATUS_INVALID_ARGUMENT;
}

/* A column count this wide fits an int16_t offset from any eye inside the window, in traverse_hit_t. */
enum : uint32_t { TRAVERSE_COLUMNS_WIDE_MAX = 2047u };

/* A ray's steps: each moves at least one coordinate forward by at least one, and no coordinate ever moves back, so a ray takes
 * at most width + width + height steps. The cap is that and some room, so it can only trip on a bug, and a test says it never
 * does. */
static inline gpu_status_t traverse_view_from(gpu_error_t *error, const traverse_world_t *world,
                                              traverse_view_t *view) {
    const world_buffers_window_t *const window = &world->window;
    if (window->side == 0u || window->side > TRAVERSE_COLUMNS_WIDE_MAX ||
        window->slot_count != window->side * window->side || window->min_slot_x >= window->side ||
        window->min_slot_y >= window->side) {
        return traverse_refuse(error, "traverse: the window is empty, too wide, or not a square of slots");
    }
    if (world->borrowed_table->bytes < (uint64_t)window->slot_count * sizeof(world_buffers_column_t)) {
        return traverse_refuse(error, "traverse: the column table is smaller than the window says");
    }
    if (world->borrowed_shapes != nullptr && world->borrowed_shapes->bytes < (uint64_t)world->shape_count) {
        return traverse_refuse(error, "traverse: the shape table is smaller than the world says");
    }
    const uint64_t blocks = (uint64_t)window->side * TRAVERSE_COLUMN_BLOCKS;
    view->borrowed_table = (const world_buffers_column_t *)(const void *)device_memory_pointer(world->borrowed_table);
    view->borrowed_pool = device_memory_pointer(world->borrowed_pool);
    view->borrowed_shapes = world->borrowed_shapes != nullptr ? device_memory_pointer(world->borrowed_shapes) : nullptr;
    view->window_min_column[0] = window->min_x;
    view->window_min_column[1] = window->min_y;
    view->window_min_block[0] = window->min_x * (int32_t)TRAVERSE_COLUMN_BLOCKS;
    view->window_min_block[1] = window->min_y * (int32_t)TRAVERSE_COLUMN_BLOCKS;
    view->origin_slot[0] = window->min_slot_x;
    view->origin_slot[1] = window->min_slot_y;
    view->columns_wide = window->side;
    view->window_blocks = (uint32_t)blocks;
    view->max_steps = (uint32_t)(blocks * 2u) + 2u * TRAVERSE_HEIGHT_BLOCKS + 16u;
    view->shape_count = world->borrowed_shapes != nullptr ? (uint16_t)world->shape_count : (uint16_t)0u;
    view->top_limit = world->top_limit != 0u && world->top_limit < TRAVERSE_HEIGHT_BLOCKS
                          ? (uint16_t)world->top_limit
                          : (uint16_t)TRAVERSE_HEIGHT_BLOCKS;
    return GPU_STATUS_OK;
}

#endif
